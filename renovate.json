{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranchPatterns": ["main"],
  "enabledManagers": ["gomod", "github-actions"],
  "branchTopic": "{{{depNameSanitized}}}-{{{newVersion}}}",
  "rebaseWhen": "conflicted",
  "prConcurrentLimit": 3,
  "prCreation": "status-success",
  "lockFileMaintenance": {
    "enabled": false
  },
  "postUpgradeTasks": {
    "commands": ["make vendor"],
    "fileFilters": ["go.mod", "go.sum", "vendor/**"],
    "executionMode": "branch",
    "installTools": {
      "golang": {}
    }
  },
  "packageRules": [
    {
      "description": "Group Go digest, patch, and minor updates",
      "matchManagers": ["gomod"],
      "groupName": "all dependencies",
      "matchUpdateTypes": ["digest", "patch", "minor"]
    },
    {
      "description": "Group direct major Go updates and rewrite import paths",
      "matchManagers": ["gomod"],
      "groupName": "major dependencies",
      "matchUpdateTypes": ["major"],
      "matchDepTypes": ["require"],
      "postUpdateOptions": ["gomodUpdateImportPaths"]
    },
    {
      "description": "Disable routine k8s.io and sigs.k8s.io updates; vulnerability alerts still override this",
      "matchManagers": ["gomod"],
      "matchPackageNames": [
        "k8s.io/{/,}**",
        "sigs.k8s.io/{/,}**"
      ],
      "enabled": false
    }
  ],
  "labels": ["release-note-none"],
  "extends": [":gitSignOff"],
  "vulnerabilityAlerts": {
    "enabled": true,
    "additionalBranchPrefix": "security/",
    "prCreation": "status-success",
    "recreateWhen": "always"
  },
  "osvVulnerabilityAlerts": true,
  "assigneesFromCodeOwners": true,
  "separateMajorMinor": true,
  "ignorePaths": [
    "**/vendor/**"
  ]
}
