{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranchPatterns": ["main"],
  "enabledManagers": ["gomod", "github-actions"],
  "branchTopic": "{{{depNameSanitized}}}-{{{newVersion}}}",
  "rebaseWhen": "conflicted",
  "prConcurrentLimit": 3,
  "prCreation": "status-success",
  "lockFileMaintenance": {
    "enabled": false
  },
  "postUpgradeTasks": {
    "commands": ["make vendor"],
    "fileFilters": ["go.mod", "go.sum", "vendor/**"],
    "executionMode": "branch",
    "installTools": {
      "golang": {}
    }
  },
  "packageRules": [
    {
      "description": "Disable routine updates; only vulnerability-driven updates are processed",
      "matchManagers": ["gomod", "github-actions"],
      "enabled": false
    }
  ],
  "labels": ["release-note-none"],
  "extends": [":gitSignOff", ":dependencyDashboard"],
  "vulnerabilityAlerts": {
    "enabled": true,
    "additionalBranchPrefix": "security/",
    "prCreation": "status-success",
    "recreateWhen": "always"
  },
  "osvVulnerabilityAlerts": true,
  "assigneesFromCodeOwners": true,
  "separateMajorMinor": true,
  "ignorePaths": [
    "**/vendor/**"
  ]
}
